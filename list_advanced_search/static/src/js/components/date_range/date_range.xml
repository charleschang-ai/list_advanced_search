<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="list_advanced_search.DateRange">
        <div class="o_las_date_range_container">
        <div class="o_las_date_range">
            <div class="o_las_date_input">
                <DateTimeInput
                    value="this.state.from"
                    type="'date'"
                    placeholder="this.fromPlaceholder"
                    onChange.bind="this.onDateFromChanged"
                />
            </div>
            <div class="o_las_arrow">
                <i class="oi" data-icon="arrow_forward"/>
            </div>
            <div class="o_las_date_input">
                <DateTimeInput
                    value="this.state.to"
                    type="'date'"
                    placeholder="this.toPlaceholder"
                    onChange.bind="this.onDateToChanged"
                />
            </div>
        </div>
        </div>
    </t>
</templates>
