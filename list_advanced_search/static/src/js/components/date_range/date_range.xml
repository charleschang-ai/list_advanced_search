<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="list_advanced_search.DateRange">
        <div class="o_las_date_range_container">
        <div class="o_las_date_range">
            <div class="o_las_date_input">
                <DateTimeInput
                    value="state.from"
                    type="'date'"
                    placeholder="fromPlaceholder"
                    onChange.bind="onDateFromChanged"
                />
            </div>
            <div class="o_las_arrow">
                <i class="oi oi-arrow-right"/>
            </div>
            <div class="o_las_date_input">
                <DateTimeInput
                    value="state.to"
                    type="'date'"
                    placeholder="toPlaceholder"
                    onChange.bind="onDateToChanged"
                />
            </div>
        </div>
        </div>
    </t>
</templates>
